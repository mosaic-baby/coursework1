<Window x:Class="coursework1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:coursework1"
        mc:Ignorable="d"
        Title="Приложение для викторин" Height="450" Width="700">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Доступные викторины" 
                   FontSize="24" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>

        <!-- Список викторин -->
        <ListBox Grid.Row="1" x:Name="QuizzesListBox" 
                 DisplayMemberPath="Title" FontSize="16" 
                 Background="White" BorderBrush="#E0E0E0" BorderThickness="1"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="CreateQuizButton" Content="Создать викторину" 
                    Width="180" Height="40" FontSize="14" Margin="0,0,10,0"
                    Background="#E1E1E1" BorderThickness="0" Click="CreateQuizButton_Click"/>

            <Button x:Name="StartQuizButton" Content="Начать прохождение" 
                    Width="180" Height="40" FontSize="14" FontWeight="Bold"
                    Background="#007ACC" Foreground="White" BorderThickness="0" Click="StartQuizButton_Click"/>
            
        </StackPanel>
        
        
    </Grid>
</Window>
