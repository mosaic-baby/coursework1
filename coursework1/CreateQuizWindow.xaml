<Window x:Class="coursework1.CreateQuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:coursework1"
        mc:Ignorable="d"
        Title="Создание новой викторины" Height="600" Width="550">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Название викторины -->
            <RowDefinition Height="Auto"/>
            <!-- Текст вопроса -->
            <RowDefinition Height="Auto"/>
            <!-- Варианты ответов -->
            <RowDefinition Height="*"/>
            <!-- Список добавленных вопросов -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка Готово -->
        </Grid.RowDefinitions>

        <!-- Блок 1: Название викторины -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Название викторины:" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="QuizTitleTextBox" FontSize="14" Padding="5"/>

            <!-- Блок 2: Новый вопрос -->
            <GroupBox Grid.Row="1" Header="Добавление вопроса" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBox Text="Текст вопроса:" Margin="0,0,0,3"/>
                    <TextBox x:Name="QuestionTextBox" Margin="0,0,0,10" Padding="3"/>

                    <TextBlock Text="Правильный ответ:" Foreground="Green" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="CorrectAnswerTextBox" Margin="0,0,0,10" Padding="3"/>

                    <TextBlock Text="Неправильный вариант 1:" Foreground="Red" Margin="0,0,0,3"/>
                    <TextBox x:Name="WrongAnswer1TextBox" Margin="0,0,0,5" Padding="3"/>

                    <TextBlock Text="Неправильный вариант 2:" Foreground="Red" Margin="0,0,0,3"/>
                    <TextBox x:Name="WrongAnswer2TextBox" Margin="0,0,0,10" Padding="3"/>

                    <Button Content="Добавить вопрос в список" Background="#E1E1E1" Height="30" Click="AddQuestionButton_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Блок 3: Список уже добавленных вопросов -->
            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock x:Name="AddedQuestionsText" Text="Вопросов в текущей викторине: 0" Margin="0,0,0,5"/>
                <ListBox x:Name="AddedQuestionsListBox" DisplayMemberPath="Text" Height="80" Background="White"/>
            </StackPanel>

            <!-- Блок 4: Сохранение всей викторины -->
            <Button Grid.Row="4" Content="Сохранить викторину" Background="#007ACC" Foreground="White" 
                FontWeight="Bold" Height="40" Click="SaveQuizButton_Click"/>
                
        </StackPanel>
        
    </Grid>
</Window>
